# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Optional. With it unset, the cookie notice never appears and no request is
# ever made to Google, which is what a local build or a fork should do.
# Analytics only loads after someone presses Accept on that notice.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# VITE_CLARITY_ID: Microsoft Clarity project id. Optional, independent of GA.
# Build time, like the GA id above. Clarity records the screen, so it loads
# only after a person presses Accept and with what people type into forms
# masked, and with no id set it never runs. Get the id from
# clarity.microsoft.com, Settings, Overview.
VITE_CLARITY_ID="XXXXXXXXXX"

# KV_REST_API_URL / KV_REST_API_TOKEN: the durable store behind the cookieless
# visit counter (one integer that goes up on each visit, nothing about anyone).
# Provisioned by adding the Upstash Redis / KV integration in the Vercel
# dashboard, which sets these two variables automatically. Server-side only, so
# no VITE_ prefix and no rebuild needed, only a redeploy. With them unset the
# counter falls back to an in-process number that resets on restart, so set
# them for a figure a funding bid can rely on. UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN are accepted as aliases.
KV_REST_API_URL="https://xxxx.upstash.io"
KV_REST_API_TOKEN="XXXXXXXX"
